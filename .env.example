# Copy to .env and fill in. Nothing here is required for the demonstration site:
# without DATABASE_URL the web app replays the recorded run and runs the browser instruments.

# --- shared by the web app and the research workers ------------------------------
# PostgreSQL 16 or newer. The web app reads it; workers read and write it.
DATABASE_URL=postgresql://noether:change-me@localhost:5432/noether

# --- web app (web/) ---------------------------------------------------------------
# Bearer token for owner controls (pause, resume, cancel, new bounded tasks).
# Generate one with: openssl rand -hex 32. Leave empty to disable every write endpoint.
NOETHER_ADMIN_TOKEN=

# --- research workers (research/) -----------------------------------------------
# Model provider. Without a key, model-backed roles block with a recorded reason.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Hard daily caps; a task reserves its estimate before any model call.
NOETHER_DAILY_USD=25
NOETHER_DAILY_TOKENS=4000000
# Worker behaviour
NOETHER_CONCURRENCY=2
NOETHER_LEASE_SECONDS=60
NOETHER_HEARTBEAT_SECONDS=10
NOETHER_SANDBOX_MEMORY_MB=2048
# Content-addressed artifact store (use a persistent volume in production)
NOETHER_ARTIFACT_DIR=/var/lib/noether/artifacts
# Pinned Lean toolchain binary (see lean/lean-toolchain)
NOETHER_LEAN_BIN=lean
# Identifies this deployment to arXiv in the User-Agent; use a contact address you read
NOETHER_ARXIV_CONTACT=
